NEXT_PUBLIC_LIVE_WS_URL=ws://127.0.0.1:8787
# Relay + Next.js app both read this Supabase project URL name.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Still required by the Next.js server routes; the bridge itself no longer
# reads it (dual-write pairs below).
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_TABLE_NAME=meter_readings
SUPABASE_BATCH_MINUTES=10
PORT_CSV_BACKUP_DIR=./logs/inverter-port-backups
PORT_CSV_BACKUP_PREFIX=inverter_ports
WEATHER_CSV_BACKUP_DIR=./logs/weather-backups
WEATHER_CSV_BACKUP_PREFIX=weather
# --- Universal Relay dual-write (Phase 1+). Fill BOTH pairs; table names
# and CSV dirs default correctly when left blank.
HOME_SUPABASE_URL=
HOME_SUPABASE_SERVICE_KEY=
SOLAR_SUPABASE_URL=
SOLAR_SUPABASE_SERVICE_KEY=
# Shadow-mode only (pre-cutover verification): alternate WS port + skip of
# the solar daily read-modify-write while the old relay still owns it.
UNIVERSAL_SHADOW_MODE=0
BRIDGE_PORT=8787
